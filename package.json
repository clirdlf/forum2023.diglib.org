{
  "name": "forum2023-static",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs && eleventy",
    "dev": "eleventy --serve",
    "check": "node scripts/check.mjs",
    "import:wordpress": "node scripts/import-wordpress.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:visual": "VISUAL_TEST=1 playwright test visual.spec.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "cheerio": "1.2.0",
    "eslint": "10.13.0",
    "fast-xml-parser": "5.11.2",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.14.0 <27"
  }
}
